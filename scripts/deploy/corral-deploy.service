# Installed by scripts/deploy/README.md. Set the path to your Corral checkout
# and the user who owns it; git refuses a checkout owned by another user.
[Unit]
Description=Redeploy Corral if main has moved
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=corral
ExecStart=/opt/corral/scripts/deploy/auto-deploy.sh
