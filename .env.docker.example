# Home-server Compose settings. No model-provider or GitHub credentials (D2).
# Generate with: openssl rand -hex 32. It goes into a URL unencoded, so
# characters like @ / : stop the server from connecting.
POSTGRES_PASSWORD=
CORRAL_PUBLIC_URL=https://corral.example.com
# Generate with: openssl rand -hex 32. Share only with your runners.
CORRAL_RUNNER_TOKEN=
# Safe default: loopback only. For remote runners set the home server's
# Tailscale IPv4 address (100.x.y.z), never 0.0.0.0 or its LAN address.
CORRAL_RUNNER_BIND_ADDRESS=127.0.0.1
CORRAL_RUNNER_PORT=4200
CORRAL_RUNNER_NAME=home-server
CORRAL_GIT_AUTHOR_NAME=
CORRAL_GIT_AUTHOR_EMAIL=
# Memory limits. The server and web defaults aren't measured yet: raise them
# if a container restarts with exit code 137.
# CORRAL_SERVER_MEMORY=1g
# CORRAL_WEB_MEMORY=512m
