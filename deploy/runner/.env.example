# Copy to deploy/runner/.env. Never add model-provider or GitHub credentials.
# Use the home server's full MagicDNS name, or its Tailscale IPv4 address.
CORRAL_SERVER_URL=http://home-server.example-tailnet.ts.net:4200
# Same random secret as the home-server .env; not a model-provider token.
CORRAL_RUNNER_TOKEN=
CORRAL_RUNNER_NAME=gaming-pc
# Leave off until the updater timer (COR-188) is installed: a behind runner
# with this on drains itself and takes no work until something updates it.
CORRAL_RUNNER_AUTO_UPDATE=false
CORRAL_RUNNER_SLOTS=4
CORRAL_RUNNER_ROLES=developer,reviewer,design
CORRAL_GIT_AUTHOR_NAME=
CORRAL_GIT_AUTHOR_EMAIL=
CORRAL_RUNNER_MEMORY=6g
