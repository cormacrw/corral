# Corral reads its environment-specific settings from these variables (D12).
# All are optional for local development. `pnpm dev` (scripts/dev.ts) sets
# them per checkout: data under .corral/, and the default ports below, or free
# ones if those are taken. The commented values are what an app falls back to
# when started on its own.
# Never put model-provider or GitHub credentials here (D2).

# apps/server
# CORRAL_SERVER_DATA_DIR=$HOME/.corral/server
# CORRAL_SERVER_HOST=127.0.0.1
# CORRAL_SERVER_PORT=4100
# Postgres for the deployed instance and CI; unset uses PGlite in the data dir (D14)
# CORRAL_DATABASE_URL=postgres://corral:<password>@postgres:5432/corral

# apps/runner
# CORRAL_RUNNER_DATA_DIR=$HOME/.corral/runner

# apps/web (dev server)
# CORRAL_WEB_PORT=3000

# apps/runner, and the /api proxy target in apps/web
# CORRAL_SERVER_URL=http://127.0.0.1:4100
