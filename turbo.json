{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["eslint.config.mjs", "scripts/check-cpus.ts"],
  "globalPassThroughEnv": ["CORRAL_CHECK_CPUS", "VITEST_MAX_WORKERS"],
  "tasks": {
    "build": {
      "outputs": [".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CORRAL_*"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "env": ["CORRAL_DATABASE_URL"]
    }
  }
}
